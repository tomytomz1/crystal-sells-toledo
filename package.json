{
  "name": "crystal-sells-toledo",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for Crystal Sells Toledo \u2014 Perrysburg / 43551 real estate, Key Realty.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs && npx --yes serve@14 public -l 3000",
    "check": "node tools/check.mjs",
    "verify:live": "node tools/verify-live.mjs",
    "test": "node tools/build.mjs && node tools/check.mjs && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/api.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:hubspot": "node --test tests/hubspot.test.mjs",
    "test:mail": "node --test tests/mail.test.mjs",
    "test:consent": "node --test tests/consent.test.mjs",
    "test:consent-state": "node --test tests/consent-state.test.mjs",
    "zoho:verify": "node tools/zoho-verify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.55.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "nodemailer": "^10.0.1"
  }
}
