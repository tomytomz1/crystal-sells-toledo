# ---------------------------------------------------------------------------
# Server-side configuration for POST /api/lead
#
# Set these in Vercel: Project -> Settings -> Environment Variables.
# NEVER commit real values. NEVER prefix any of these with NEXT_PUBLIC_ or
# otherwise expose them to the browser - the lead endpoint is the only thing
# that may see them.
# ---------------------------------------------------------------------------

# ===========================================================================
# LIVE PATH - HubSpot
# ===========================================================================
# This is the CRM the site actually delivers to. Without the three required
# variables the endpoint returns 503 NOT_CONFIGURED by design and the form
# shows its recovery panel - it never claims a lead was received when it was
# not.

# Private app / service key. Scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, forms.  REQUIRED.
HUBSPOT_ACCESS_TOKEN=

# HubSpot account (portal) ID - the numeric hub id.  REQUIRED for the
# authenticated Forms Submission API, which is what records a dated
# "Form submitted" activity against the contact.
HUBSPOT_PORTAL_ID=

# GUID of the HubSpot form the submission is posted to.  REQUIRED, same
# reason as HUBSPOT_PORTAL_ID.
HUBSPOT_FORM_GUID=

# Optional API hosts. Leave unset unless a test double or a regional host is
# genuinely needed; the defaults are the production HubSpot endpoints.
# Defaults: https://api.hubapi.com  and  https://api.hsforms.com
HUBSPOT_API_BASE=
HUBSPOT_FORMS_BASE=

# ===========================================================================
# OPTIONAL - front-end services
# ===========================================================================

# Google Maps / Places browser key, used ONLY for address autocomplete on the
# valuation form. Unset, the address field stays an ordinary text input and
# nothing is sent to Google. This key IS emitted into the page, so restrict it
# in the Google console by HTTP referrer and to the Maps JavaScript API and
# Places API (New).
GOOGLE_MAPS_API_KEY=

# Google Analytics 4 measurement id. The tag is only emitted when Vercel
# reports VERCEL_ENV=production (or GA4_FORCE=1 locally), so preview and local
# builds stay untracked. A default id is compiled in; set this to override it.
GA4_MEASUREMENT_ID=

# ===========================================================================
# OPTIONAL - request origin allow-list
# ===========================================================================
# Extra hostnames permitted to POST to /api/lead, comma separated.
#
# Already allowed without configuration: crystalsellstoledo.com,
# www.crystalsellstoledo.com, localhost, 127.0.0.1, and both hostnames Vercel
# sets for the current deployment - VERCEL_URL (the immutable deployment
# hostname) and VERCEL_BRANCH_URL (the generated branch hostname). Preview
# testing therefore needs nothing here: the deployment URL Vercel prints and
# the branch URL both work as they are.
#
# Arbitrary *.vercel.app hostnames are NOT allowed: vercel.app is a shared
# domain, so a suffix match would let any Vercel project on earth post here.
# A sibling deployment, another branch of this project, or someone else's
# project are all different strings and all refused.
#
# Use this variable for a host Vercel does not name for us - a staging domain,
# or a preview host from somewhere other than this project's own deployment.
ALLOWED_ORIGINS=

# ===========================================================================
# COMMUNICATIONS CONSENT - feature gate
# ===========================================================================
# One switch, read in TWO places within a single deployment:
#
#   * BUILD TIME  - tools/build.mjs. Decides whether the consent checkboxes
#     render on any form, whether /communications-terms is built at all, and
#     whether the privacy page carries its messaging section.
#   * RUNTIME     - api/lead.js via api/_lib/consent.mjs. Decides whether a
#     consent payload is turned into evidence and written to HubSpot.
#
# Vercel exposes the same variable to the build and to the function, so the
# two halves cannot disagree. Set it in ONE place and both follow.
#
# Enabled ONLY by the exact string "true". Absent, empty, "1", "yes" or
# "TRUE" all leave it off - a compliance feature should not switch itself on
# through a typo.
#
# LEAVE THIS FALSE until the HubSpot setup in
# docs/updates/2026-09-09-communications-consent-foundation.md is complete.
# With it off, production behaves exactly as it does today: no checkbox, no
# /communications-terms route, no messaging section in the privacy policy,
# and no consent rows in the CRM enquiry block. Showing a visitor a consent
# promise the backend cannot yet preserve is the one outcome to avoid.
#
# Not a secret. It is a boolean, it carries no credential, and it may safely
# appear in build logs.
COMMUNICATIONS_CONSENT_ENABLED=false

# ===========================================================================
# COMMUNICATIONS CONSENT - the append-only evidence ledger
# ===========================================================================
# Postgres connection string for the durable consent ledger
# (`communication_consent_events`, created by
# db/001_communication_consent_events.sql). Neon Postgres via the Vercel
# Marketplace, in the same region as the function.
#
# THIS IS A SECRET AND IT IS SERVER-SIDE ONLY. It is never read by browser
# code, it is never prefixed NEXT_PUBLIC_, and tools/check.mjs fails the
# build if this name appears in anything delivered to the browser.
#
# IT MUST BE THE APPLICATION ROLE'S STRING, NEVER THE OWNER'S. The
# application role holds INSERT and nothing else - no SELECT, no UPDATE, no
# DELETE, no TRUNCATE, no DDL, no table ownership. Append-only is that grant,
# not a convention in the code. An owner credential here would make the
# ledger an ordinary mutable table.
#
# No SELECT is deliberate: the application never reads the ledger, so a
# leaked value of this variable must not be able to enumerate every phone
# number and consent decision the table holds. Reading it back - for the
# controlled round-trip check, or an audit - is done with the OWNER
# credential, outside Vercel.
#
# WITH COMMUNICATIONS_CONSENT_ENABLED OFF, THIS VARIABLE IS READ BY NOTHING:
# no evidence is built, so no append is attempted and the driver is not even
# loaded. Leave both unset until the ledger has been provisioned, migrated
# and round-trip verified.
#
# When consent IS enabled and this is absent, the endpoint still stores the
# lead and still writes the consent evidence rows to the HubSpot timeline -
# but it writes NO `cst_*` permission, and the enquiry block says
# `CONSENT LEDGER: NOT CONFIRMED`. The lead is never the casualty of an
# evidence outage; the permission is.
CONSENT_LEDGER_URL=

# ===========================================================================
# OUTBOUND SMS - DARK. Leave every value below blank.
# ===========================================================================
# api/_lib/sms-sender.mjs is the only module in this repository that can send
# an SMS, and nothing imports it: there is no orchestrator, no endpoint and
# no scheduled job that reaches it. tools/check.mjs fails the build if any
# module under api/ imports it. Setting these variables therefore does NOT
# make production capable of sending - but they are documented here because
# code now reads them, which was not true before 17 September 2026.
#
# DO NOT SET ANY OF THEM until the A2P Campaign is approved, gate 8's sender
# credential (CONSENT_LEDGER_SENDER_URL, see below) is provisioned, and a
# controlled real-boundary verification has passed. See
# docs/updates/2026-09-17-outbound-sms-sender.md.

# The switch. Enabled ONLY by the exact string "true" - absent, empty, "1",
# "yes" or "TRUE" all leave outbound messaging off. Not a secret.
OUTBOUND_SMS_ENABLED=false

# The Twilio account this sends on behalf of. Not a secret on its own.
TWILIO_ACCOUNT_SID=

# A SCOPED API KEY PAIR, and deliberately NOT TWILIO_AUTH_TOKEN. The auth
# token is the account's master secret and is the INBOUND webhook signature
# credential (api/_lib/twilio.mjs). Keeping outbound on a separate key means
# a leak of one does not hand over the other and either can be rotated alone.
#
# TWILIO_API_KEY_SECRET IS A SECRET - it is a standing authority to send
# messages on this account's behalf. Server-side only, never prefixed
# NEXT_PUBLIC_, and tools/check.mjs fails the build if either name appears in
# anything delivered to the browser.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# The registered A2P Messaging Service. The sender offers NO way to name an
# arbitrary "from" number: the Messaging Service owns sender selection and
# A2P routing, which is what keeps registered traffic registered.
TWILIO_MESSAGING_SERVICE_SID=

# Retell / AI voice credentials are deliberately NOT documented here. No code
# reads them and no voice caller exists. They get added in the phase that
# actually places a call.
#
# Gate 7's inbound credentials (TWILIO_AUTH_TOKEN, OPERATOR_ACTION_SECRET)
# and gate 8's EXECUTE-only suppression credential
# (CONSENT_LEDGER_SENDER_URL) are also read by merged code and are still
# undocumented here. Named as a follow-up rather than absorbed into this
# change: see docs/updates/2026-09-17-outbound-sms-sender.md.

# ===========================================================================
# LIVE PATH - Zoho Mail acknowledgement (SMTP)
# ===========================================================================
# Do not confuse this section with the Zoho CRM section below. They share a
# vendor name and nothing else. These four variables are the credentials for
# Crystal's real mailbox, used to send ONE short acknowledgement email to the
# visitor after their lead has already been stored in HubSpot.
#
# HubSpot remains the authoritative lead destination. The acknowledgement is
# best-effort and strictly secondary:
#
#   * If these variables are absent, api/lead.js logs `lead.ack.skipped`,
#     sends nothing, and the lead is unaffected.
#   * If the SMTP send fails for any reason, api/lead.js logs
#     `lead.ack.failed` with a classification only and STILL returns its
#     normal 200 { ok: true, submission_id }.
#   * A mail failure must never lose, delay or duplicate a HubSpot lead, and
#     must never tell a visitor to submit the form again.
#
# Server-side only. None of these is ever read by browser code, none is ever
# prefixed NEXT_PUBLIC_, and tools/check.mjs fails the build if the password
# name appears in anything delivered to the browser. The send happens inside
# the Vercel function; the browser never sees the SMTP credentials.
#
# The From address is `Crystal Saylor <crystal@crystalsellstoledo.com>` and is
# fixed in api/_lib/mail.mjs. Zoho refuses a From that is not the
# authenticated mailbox, so ZOHO_SMTP_USER must be that same address.
#
# smtppro.zoho.com is the host for a paid/custom-domain Zoho mailbox.
# Port 465 is implicit TLS; 587 would be STARTTLS.
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

# ===========================================================================
# ROLLBACK ONLY - Zoho CRM (NOT the live path, NOT imported by any code)
# ===========================================================================
# These are OAuth credentials for the dormant Zoho CRM client - unrelated to
# the Zoho Mail SMTP section above.
# The Zoho client is retained as a rollback path and is imported by nothing.
# Setting these does NOT switch delivery to Zoho; api/lead.js talks to HubSpot.
# Leave every value below blank in production.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=
