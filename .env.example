# Server-side configuration for crystalsellstoledo.com.
#
# This file documents the configuration CONTRACT, not the current values or
# environment scopes. Current Production truth belongs in docs/CURRENT-STATE.md.
# Never commit real credentials. Never prefix a server secret with NEXT_PUBLIC_.

# ===========================================================================
# LIVE LEAD PATH — HUBSPOT
# ===========================================================================
# Required for /api/lead delivery. Missing required values fail closed.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Optional endpoint overrides; normally leave blank.
HUBSPOT_API_BASE=
HUBSPOT_FORMS_BASE=

# ===========================================================================
# FRONT-END / ANALYTICS
# ===========================================================================
# Browser key; restrict by referrer and API in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional override for the compiled GA4 measurement id.
GA4_MEASUREMENT_ID=

# Optional extra hosts allowed to POST to /api/lead, comma separated.
# The production domains, localhost/127.0.0.1, VERCEL_URL and
# VERCEL_BRANCH_URL are handled by code without this variable.
ALLOWED_ORIGINS=

# ===========================================================================
# CLOUDFLARE TURNSTILE — LEAD HUMAN/BOT VERIFICATION
# ===========================================================================
# Exact "true" enables. Exact "false", empty, or absent disables.
# Enabled with a missing key is a configuration error and fails closed.
TURNSTILE_ENABLED=false

# Public widget key; may be emitted to protected form pages.
TURNSTILE_SITE_KEY=

# SECRET, server-side Siteverify key.
TURNSTILE_SECRET_KEY=

# ===========================================================================
# COMMUNICATIONS CONSENT
# ===========================================================================
# Exact "true" enables both the build-time consent UI/legal surfaces and the
# runtime consent-evidence path. Other values do not enable it.
COMMUNICATIONS_CONSENT_ENABLED=false

# SECRET. Append-only website role for communication_consent_events.
# The role is INSERT-only: no SELECT/UPDATE/DELETE/TRUNCATE and no sender lookup.
CONSENT_LEDGER_URL=

# ===========================================================================
# GATE 7 — INBOUND TWILIO STOP / HELP + OPERATOR SUPPRESSION
# ===========================================================================
# SECRET. Twilio account auth token used only to validate inbound webhook
# signatures. It is NOT an outbound SMS or Consent Management credential.
TWILIO_AUTH_TOKEN=

# SECRET, >=32 bytes of entropy. Seals operator-action bearer capabilities.
OPERATOR_ACTION_SECRET=

# The inbound webhook persists suppression through CONSENT_LEDGER_URL above.
# Unclassified-message operator surfacing also depends on the Zoho Mail SMTP
# variables in the section below.

# ===========================================================================
# OPERATOR UNSUPPRESSION
# ===========================================================================
# Both are SECRET and server-side only. The operator workflow is deliberately
# separate from ordinary suppression and from outbound/provider credentials.
OPERATOR_UNSUPPRESS_SECRET=
CONSENT_LEDGER_OPERATOR_URL=

# ===========================================================================
# WEBSITE SMS RE-OPT-IN
# ===========================================================================
# Exact "true" enables re-opt-in reconciliation when communications consent is
# also enabled and the dedicated re-opt-in ledger credential is configured.
#
# Two paths are supported:
#   1. automatic website re-opt-in: fresh durable SMS checkbox consent after a
#      STOP -> Twilio Consent Management API confirms BOTH required opt-ins ->
#      append-only SMS clearance -> HubSpot projection -> Gate 8 -> send; and
#   2. provider-confirmed inbound START, retained as a manual fallback.
#
# Fresh website consent alone never clears Neon. Provider failure, partial
# provider success, a global do-not-contact, a new STOP, or any malformed
# dependency leaves the send path closed.
SMS_REOPTIN_ENABLED=false

# SECRET. Dedicated consent_ledger_reoptin role from db/004. After db/005 it
# may also EXECUTE complete_website_sms_reoptin(...). It still has no table
# SELECT/UPDATE/DELETE/TRUNCATE and is not the owner credential.
CONSENT_LEDGER_REOPTIN_URL=

# Dedicated Twilio Consent Management API credential. Do not reuse
# TWILIO_AUTH_TOKEN. Prefer a Restricted API key with only the permission
# needed to POST the Consent Management bulk upsert endpoint. If Twilio does
# not expose that permission for the account, use a dedicated Standard API key
# only after the operator accepts the wider scope.
TWILIO_CONSENT_API_KEY_SID=
TWILIO_CONSENT_API_KEY_SECRET=

# Non-secret provider identifiers used to clear BOTH Twilio STOP records.
# Twilio documents that a Messaging Service STOP creates one block at the
# Messaging Service level and one at the actual sender-number level, so both
# values are required for automatic re-opt-in.
TWILIO_CONSENT_MESSAGING_SERVICE_SID=
TWILIO_CONSENT_SENDER_NUMBER=

# ===========================================================================
# GATE 8 — SEND-TIME DURABLE SUPPRESSION LOOKUP
# ===========================================================================
# SECRET. Dedicated consent_ledger_sender role. It may EXECUTE the one-number
# get_suppression_state(text) function and must not receive table privileges.
# It is NOT CONSENT_LEDGER_URL and NOT CONSENT_LEDGER_OPERATOR_URL.
CONSENT_LEDGER_SENDER_URL=

# ===========================================================================
# OUTBOUND SMS TRANSPORT
# ===========================================================================
# Exact "true" enables the acknowledgement sender. Gate 8 remains mandatory.
OUTBOUND_SMS_ENABLED=false

# Outbound message sending uses its own separate Twilio API Key pair; never
# reuse TWILIO_AUTH_TOKEN or the Consent Management API credential above.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=

# ===========================================================================
# ZOHO MAIL — ACKNOWLEDGEMENT + OPERATOR EMAIL TRANSPORT
# ===========================================================================
# SECRET server-side mailbox credentials except host/port. Mail delivery is
# best-effort for lead acknowledgement; missing/failing acknowledgement mail
# must not lose a stored HubSpot lead. Gate 7 unclassified-message surfacing,
# however, fails loudly if the operator cannot be notified.
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

# ===========================================================================
# ZOHO CRM — ROLLBACK ONLY
# ===========================================================================
# Dormant rollback client. Setting these values does not switch the live CRM
# away from HubSpot. Leave blank unless deliberately executing a rollback.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=
