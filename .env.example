# ---------------------------------------------------------------------------
# Server-side secrets for POST /api/lead
#
# Set these in Vercel: Project -> Settings -> Environment Variables.
# NEVER commit real values. NEVER prefix any of these with NEXT_PUBLIC_ or
# otherwise expose them to the browser - the lead endpoint is the only thing
# that may see them.
# ---------------------------------------------------------------------------

# Zoho CRM self-client OAuth (see README "Connecting Zoho CRM")
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data-centre endpoints. Defaults suit the .com data centre; change both if
# the Zoho account lives in .eu, .in, .com.au, .jp or .ca.
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Optional: extra hostnames permitted to POST, comma separated.
# crystalsellstoledo.com, www., localhost and *.vercel.app are already allowed.
ALLOWED_ORIGINS=
